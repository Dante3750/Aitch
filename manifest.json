{
  "manifest_version": 3,
  "name": "DanteHelp",
  "version": "0.3.0",
  "description": "Blocks ads on the web. Network blocking plus ad-slot hiding.",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/selectors.js", "content/cosmetic.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "DanteHelp",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dantehelp@dante.local",
      "strict_min_version": "121.0"
    }
  }
}
